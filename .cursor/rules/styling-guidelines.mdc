## Component Styling Patterns

### Image Display Cards
```tsx
// Original image container
<div className="bg-gray-900 rounded-2xl overflow-hidden border border-gray-800 shadow-2xl">
  {/* Header with emoji and title */}
  <div className="bg-black px-4 py-3 flex items-center gap-2">
    <span className="text-xl">📸</span>
    <span className="text-white font-bold text-sm tracking-wide uppercase">Original</span>
  </div>
  
  {/* Image container with pink gradient background */}
  <div className="aspect-square bg-gradient-to-br from-pink-300 to-pink-500 p-6 md:p-8">
    <div className="w-full h-full bg-white rounded-xl overflow-hidden shadow-lg">
      <img 
        src={imageUrl} 
        alt="Original" 
        className="w-full h-full object-cover"
      />
    </div>
  </div>
</div>

// Preview container (blue variant)
<div className="bg-gray-900 rounded-2xl overflow-hidden border border-gray-800 shadow-2xl">
  <div className="bg-black px-4 py-3 flex items-center gap-2">
    <span className="text-xl">🎨</span>
    <span className="text-white font-bold text-sm tracking-wide uppercase">Preview</span>
  </div>
  
  <div className="aspect-square bg-gradient-to-br from-blue-300 to-blue-500 p-6 md:p-8 
                  flex items-center justify-center">
    {generatedImage ? (
      <div className="w-full h-full bg-white rounded-xl overflow-hidden shadow-lg">
        <img src={generatedImage} alt="Generated" className="w-full h-full object-cover" />
      </div>
    ) : (
      <div className="text-center text-gray-600">
        <div className="text-4xl mb-3">🎨</div>
        <p className="text-sm font-medium">AI-edited image will appear here</p>
      </div>
    )}
  </div>
</div>
```

### Button Styles
```tsx
// Primary action button (Start Over)
<Button className="w-full bg-white text-black font-bold py-3 px-6 rounded-xl
                   hover:bg-gray-100 active:bg-gray-200
                   transition-all duration-200 border-2 border-gray-300 
                   shadow-lg hover:shadow-xl">
  <span className="mr-2">🔄</span>
  Start Over
</Button>

// Generate button (gradient, prominent)
<Button 
  className="w-full bg-gradient-to-r from-green-500 to-blue-500 
             text-white font-bold py-4 px-8 rounded-xl
             hover:from-green-600 hover:to-blue-600 
             active:from-green-700 active:to-blue-700
             transition-all duration-200 shadow-xl hover:shadow-2xl
             disabled:opacity-50 disabled:cursor-not-allowed
             disabled:hover:from-green-500 disabled:hover:to-blue-500"
  disabled={isLoading || !uploadedImage || !prompt}
>
  {isLoading ? (
    <div className="flex items-center justify-center gap-2">
      <div className="animate-spin w-4 h-4 border-2 border-white border-t-transparent rounded-full" />
      <span>Processing...</span>
    </div>
  ) : (
    <div className="flex items-center justify-center gap-2">
      <span>✨</span>
      <span>Generate Image</span>
    </div>
  )}
</Button>
```

### Text Input Styling
```tsx
// Large prompt textarea with character count
<div className="relative">
  <textarea
    placeholder="💭 Describe your edit..."
    value={prompt}
    onChange={(e) => setPrompt(e.target.value)}
    maxLength={500}
    className="w-full bg-gray-900 border-2 border-gray-700 rounded-2xl
               px-6 py-4 text-white placeholder-gray-400
               focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20
               hover:border-gray-600 transition-all duration-200
               resize-none min-h-[120px] text-base leading-relaxed
               shadow-inner"
  />
  
  {/* Character count in bottom right */}
  <div className="absolute bottom-4 right-4 text-xs text-gray-500 pointer-events-none">
    {prompt.length}/500
  </div>
</div>
```

